{
    "version": 1,
    "project": "padloc",
    "proxy": {
        "enabled": true
    },
    "defaults": {
        "startupTimeoutSeconds": 120,
        "remainOnExit": true
    },
    "services": {
        "api": {
            "cwd": "packages/worker",
            "command": "npm run dev",
            "env": {
                "PL_WORKER_PORT": "{{PORT}}"
            },
            "health": {
                "type": "http",
                "url": "http://127.0.0.1:8787/healthcheck",
                "expectStatus": 200
            },
            "proxy": true
        },
        "web": {
            "cwd": ".",
            "command": "npm --prefix packages/pwa run dev",
            "env": {
                "PL_SERVER_URL": "http://api.{{INSTANCE}}.{{PROJECT}}.localhost",
                "PL_PWA_PORT": "{{PORT}}",
                "PL_PWA_URL": "http://web.{{INSTANCE}}.{{PROJECT}}.localhost"
            },
            "health": {
                "type": "port",
                "port": 3000
            },
            "dependsOn": ["api"],
            "proxy": true
        },
        "v3": {
            "cwd": ".",
            "command": "./node_modules/.bin/http-server cypress/fixtures/v3-client -s -p \"$PORT\" --proxy \"http://0.0.0.0:$PORT?\"",
            "health": {
                "type": "port",
                "port": 8081
            },
            "proxy": false
        },
        "maildev": {
            "cwd": ".",
            "command": "mise exec node@16.13.1 -- node scripts/start-maildev.cjs",
            "env": {
                "MAILDEV_WEB_PORT": "{{PORT}}",
                "MAILDEV_SMTP_PORT": "{{PORT_SMTP}}"
            },
            "ports": {
                "smtp": 1025
            },
            "health": {
                "type": "http",
                "url": "http://127.0.0.1:1080/email",
                "expectStatus": 200
            },
            "proxy": true
        },
        "tauri": {
            "cwd": ".",
            "command": "npm --prefix packages/tauri run dev",
            "env": {
                "PL_SERVER_URL": "http://api.{{INSTANCE}}.{{PROJECT}}.localhost"
            },
            "health": {
                "type": "none"
            },
            "dependsOn": ["api"],
            "proxy": false
        }
    }
}
