{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "strictPropertyInitialization": false,
        "declaration": false,
        "emitDecoratorMetadata": true,
        "baseUrl": ".",
        "paths": {
            "@elf-vault/core/*": ["../core/*"],
            "@elf-vault/app/*": ["./*"],
            "@elf-vault/locale/*": ["../locale/*"]
        },
        "outDir": "dist",
        "sourceMap": true,
        "module": "esnext",
        "strict": true
    },
    "include": ["src/**/*.ts", "types/**/*.ts"],
    "exclude": ["node_modules/**/*.ts"]
}
