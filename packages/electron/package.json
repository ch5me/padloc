{
    "name": "@padloc/electron",
    "version": "4.3.0",
    "description": "Electron Wrapper for Padloc app",
    "main": "main.js",
    "private": true,
    "scripts": {
        "prepare-build": "node prepare-build.js",
        "build": "npm run prepare-build && webpack && electron-builder --config build/build.json",
        "build:flatpak": "npm run prepare-build && webpack && electron-builder --config build/build-flatpak.json"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/padloc/padloc.git"
    },
    "engines": {
        "node": "16.x",
        "npm": "8.x"
    },
    "author": "MaKleSoft UG",
    "license": "GPL-3.0",
    "dependencies": {
        "electron-store": "8.0.0",
        "electron-updater": "4.3.9"
    },
    "devDependencies": {
        "clean-webpack-plugin": "3.0.0",
        "css-loader": "5.2.6",
        "electron": "19.0.5",
        "electron-builder": "23.1.0",
        "electron-notarize": "1.1.1",
        "file-loader": "6.2.0",
        "html-webpack-plugin": "5.5.0",
        "raw-loader": "4.0.2",
        "sharp": "0.30.6",
        "style-loader": "2.0.0",
        "ts-loader": "9.2.5",
        "typescript": "4.4.3",
        "webpack": "5.52.1",
        "webpack-cli": "4.8.0"
    }
}
