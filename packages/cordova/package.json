{
    "name": "@padloc/cordova",
    "version": "4.3.0",
    "displayName": "Padloc",
    "private": true,
    "scripts": {
        "prepare-build": "node update-config-xml.js && webpack",
        "prepare:android": "test -d platforms/android || ./node_modules/.bin/cordova platform add android --no-save",
        "prepare:ios": "test -d platforms/ios || ./node_modules/.bin/cordova platform add ios --no-save",
        "build:android": "npm run prepare-build && npm run prepare:android && ./node_modules/.bin/cordova build android",
        "build:android:signed": "npm run prepare-build && npm run prepare:android && ./node_modules/.bin/cordova build android --release -- --packageType=apk --keystore=./android-upload-key.keystore --storePassword=\"$PL_ANDROID_STORE_PASSWORD\" --alias=\"$PL_ANDROID_KEYSTORE_ALIAS\" --password=\"$PL_ANDROID_STORE_PASSWORD\"",
        "build:ios": "npm run prepare-build && npm run prepare:ios && ./node_modules/.bin/cordova build ios"
    },
    "engines": {
        "node": "24.x",
        "npm": "11.x"
    },
    "cordova": {
        "platforms": [
            "ios",
            "android"
        ],
        "plugins": {
            "cordova-plugin-app-version": {},
            "cordova-plugin-backbutton": {},
            "cordova-plugin-statusbar": {},
            "cordova-clipboard": {},
            "cordova-plugin-qrscanner": {},
            "cordova-plugin-device": {},
            "cordova-plugin-x-socialsharing": {
                "ANDROID_SUPPORT_V4_VERSION": "24.1.1+",
                "PHOTO_LIBRARY_ADD_USAGE_DESCRIPTION": "This app requires photo library access to function properly.",
                "PHOTO_LIBRARY_USAGE_DESCRIPTION": "This app requires photo library access to function properly."
            },
            "cordova-plugin-splashscreen": {},
            "cordova-plugin-ionic-webview": {
                "ANDROID_SUPPORT_ANNOTATIONS_VERSION": "27.+"
            },
            "cordova-plugin-fingerprint-aio": {
                "FACEID_USAGE_DESCRIPTION": " "
            },
            "cordova-plugin-privacyscreen": {},
            "cordova-plugin-inappbrowser": {},
            "cordova-plugin-androidx-adapter": {},
            "cordova-plugin-keyboard": {}
        }
    },
    "dependencies": {
        "cordova-clipboard": "1.3.0",
        "cordova-ios": "6.2.0",
        "cordova-plugin-add-swift-support": "2.0.2",
        "cordova-plugin-androidx-adapter": "1.1.3",
        "cordova-plugin-app-version": "0.1.12",
        "cordova-plugin-backbutton": "0.3.0",
        "cordova-plugin-device": "2.0.3",
        "cordova-plugin-fingerprint-aio": "4.0.2",
        "cordova-plugin-inappbrowser": "5.0.0",
        "cordova-plugin-ionic-webview": "5.0.0",
        "cordova-plugin-privacyscreen": "0.4.0",
        "cordova-plugin-qrscanner": "3.0.1",
        "cordova-plugin-splashscreen": "6.0.0",
        "cordova-plugin-statusbar": "2.4.3",
        "cordova-plugin-x-socialsharing": "6.0.3",
        "es6-promise-plugin": "4.2.2",
        "typescript": "4.4.3"
    },
    "devDependencies": {
        "@types/cordova-plugin-qrscanner": "1.0.31",
        "clean-webpack-plugin": "3.0.0",
        "cordova": "11.0.0",
        "cordova-android": "10.1.2",
        "cordova-plugin-keyboard": "1.2.0",
        "css-loader": "5.2.6",
        "dotenv": "10.0.0",
        "file-loader": "6.2.0",
        "html-webpack-plugin": "5.5.0",
        "raw-loader": "4.0.2",
        "sharp": "0.30.3",
        "style-loader": "2.0.0",
        "ts-loader": "9.2.2",
        "ts-node": "10.0.0",
        "webpack": "5.108.3",
        "webpack-cli": "4.10.0",
        "xml-js": "1.6.11"
    }
}
