{
    "name": "@padloc/extension",
    "version": "4.3.0",
    "description": "Padloc Progressive Web App",
    "author": "Martin Kleinschrodt <martin@maklesoft.com>",
    "license": "GPL-3.0",
    "private": true,
    "files": [
        "src",
        "assets",
        "tsconfig.json"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/padloc/padloc.git",
        "directory": "packages/pwa"
    },
    "engines": {
        "node": "24.x",
        "npm": "11.x"
    },
    "scripts": {
        "build": "node ../../scripts/build-web-extension.cjs",
        "agentic:extension-cdp": "node scripts/agentic-extension-cdp.mjs",
        "agentic:email-signup": "node scripts/agentic-email-signup.mjs",
        "agentic:google-passkey": "node scripts/agentic-google-passkey-proof.mjs",
        "preflight:source": "node ../../scripts/preflight-web-extension-source.cjs",
        "preflight:dist": "node ../../scripts/preflight-web-extension-dist.cjs",
        "check:source": "npm run preflight:source && npx tsc -p tsconfig.json --noEmit --pretty false && npm run test:agentic-readiness",
        "test": "npm run test:node && TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' node test/passkey-rp/run-tests.cjs test/passkey-*.ts test/worker-readiness.ts",
        "test:node": "NODE_OPTIONS=--no-experimental-strip-types TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' mocha --ui tdd --require ts-node/register/transpile-only --require tsconfig-paths/register --require test/setup.ts test/autofill-broker-protocol.ts test/autofill-broker.ts test/autofill-classifier.ts test/autofill.ts test/biometric.ts test/cold-start.ts test/oauth.ts test/save.ts test/unlock-session.ts test/webauthn.ts",
        "test:agentic-readiness": "node scripts/agentic-extension-cdp.mjs --mode readiness-redaction-self-test",
        "test:passkey-rp": "TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' node test/passkey-rp/run-tests.cjs",
        "test:passkey-rp:extension": "node test/passkey-rp/extension-rp-e2e.cjs",
        "test:passkey-rp:native": "node test/passkey-rp/native-system-e2e.cjs",
        "test:harness": "playwright test --config test-harness/playwright.config.ts",
        "test:harness:install": "playwright install chromium"
    },
    "dependencies": {
        "@simplewebauthn/browser": "5.4.0",
        "@simplewebauthn/typescript-types": "5.4.0",
        "@webcomponents/webcomponentsjs": "2.5.0",
        "lit": "2.0.2",
        "webextension-polyfill-ts": "0.25.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.40.0",
        "@types/chai": "4.2.18",
        "@types/mocha": "8.2.2",
        "@types/sinon": "10.0.6",
        "chai": "4.3.4",
        "clean-webpack-plugin": "3.0.0",
        "css-loader": "5.2.6",
        "file-loader": "6.2.0",
        "html-webpack-plugin": "5.3.1",
        "http-server": "14.1.0",
        "mocha": "9.2.2",
        "playwright": "^1.40.0",
        "raw-loader": "4.0.2",
        "sharp": "0.30.6",
        "sinon": "12.0.1",
        "style-loader": "2.0.0",
        "ts-loader": "9.2.2",
        "ts-node": "10.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "4.4.3",
        "webpack": "5.108.3",
        "webpack-cli": "4.10.0"
    }
}
