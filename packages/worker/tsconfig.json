{
    "compilerOptions": {
        "target": "es2020",
        "module": "esnext",
        "moduleResolution": "node",
        "baseUrl": ".",
        "lib": ["es2020", "dom"],
        "types": ["@cloudflare/workers-types", "@types/node"],
        "paths": {
            "@elf-vault/core/*": ["../core/*"],
            "@elf-vault/locale/*": ["../locale/*"],
            "@ch5me/elf-auth-client": ["./src/types/elf-auth-client.d.ts"]
        }
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.d.ts", "global.d.ts"],
    "exclude": ["node_modules", ".wrangler"]
}
