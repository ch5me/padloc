{
    "name": "@elf-vault/pwa",
    "version": "4.3.0",
    "author": "Martin Kleinschrodt <martin@maklesoft.com>",
    "license": "GPL-3.0",
    "private": true,
    "files": [
        "src",
        "assets",
        "tsconfig.json"
    ],
    "engines": {
        "node": "24.x",
        "npm": "11.x"
    },
    "devDependencies": {
        "clean-webpack-plugin": "3.0.0",
        "css-loader": "5.2.6",
        "file-loader": "6.2.0",
        "html-webpack-plugin": "5.3.1",
        "http-server": "14.1.0",
        "raw-loader": "4.0.2",
        "sharp": "0.29.3",
        "style-loader": "2.0.0",
        "ts-loader": "9.2.2",
        "ts-node": "10.0.0",
        "typescript": "4.4.3",
        "webpack": "5.108.3",
        "webpack-cli": "4.10.0",
        "webpack-dev-server": "4.7.4",
        "webpack-pwa-manifest": "4.3.0",
        "workbox-cli": "6.5.3",
        "workbox-webpack-plugin": "6.5.3"
    },
    "scripts": {
        "build": "webpack --config webpack.config.js",
        "start": "port=\"${PL_PWA_PORT:-${PORT:?pitchfork must provide PORT}}\"; http-server ${PL_PWA_DIR:-./dist} -p \"$port\"",
        "build_and_start": "npm run build && npm run start",
        "dev": "webpack serve --config webpack.config.js"
    },
    "description": "Elf Vault Progressive Web App",
    "dependencies": {
        "@elf-vault/app": "4.3.0",
        "@elf-vault/core": "4.3.0"
    }
}
