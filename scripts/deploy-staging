#!/usr/bin/env bash
set -euo pipefail

# padloc staging deploy — the repo's self-contained entrypoint (hush-in-CI).
#
# The IDENTICAL command deploys from a laptop, a harness, or CI. Every Cloudflare
# step runs under the governed `ch5-padloc-staging` token, resolved from the repo's
# own stage-split Hush (target `wrangler-deploy-staging`) — never from a shared
# Forgejo CLOUDFLARE_API_TOKEN secret. Rotation = re-mint the token + push; CI picks
# it up with no secret edits.
#
# One governed token covers every staging Cloudflare surface:
#   - D1 migrations  (padloc-staging)          via `wrangler d1 migrations apply`
#   - worker         (padloc-worker-staging)   via `wrangler deploy --env staging`
#   - PWA            (padloc-pwa-staging Pages) via `wrangler pages deploy`
#
# Locally: `hush` + `npm` on PATH and a decryptable repo Hush is all that's needed
# (run `npm ci` first). In CI: run `bash scripts/ci-setup-hush.sh wrangler-deploy-staging`
# first (bootstraps Hush from the SOPS_AGE_KEY secret — the only Cloudflare-deploy
# secret CI holds).
#
# Usage: bash scripts/deploy-staging

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

target_field() {
  node scripts/release/target-config.mjs --stage staging --field "$1"
}

staging_app_url="$(target_field appUrl)"
staging_api_url="$(target_field apiBaseUrl)"
staging_pages_project="$(target_field pagesProject)"

deploy_sha="${PADLOC_DEPLOY_SHA:-$(git rev-parse HEAD)}"
if ! [[ "$deploy_sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "PADLOC_DEPLOY_SHA must be a full 40-character Git SHA" >&2
  exit 2
fi
if [ "$(git rev-parse HEAD)" != "$deploy_sha" ]; then
  echo "PADLOC_DEPLOY_SHA must match the checked-out commit" >&2
  exit 2
fi
export PADLOC_DEPLOY_SHA="$deploy_sha"

# Do not build or authenticate from a tree that can contain local-only content.
# Ignored dependency/build directories are safe; any other untracked path can
# enter the artifact or change the exact source being deployed.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "staging deploy requires a clean tracked index and worktree" >&2
  git status --short >&2
  exit 2
fi
unsafe_untracked_files=()
while IFS= read -r -d '' path; do
  unsafe_untracked_files+=("$path")
done < <(git ls-files --others --exclude-standard -z)

if [ "${#unsafe_untracked_files[@]}" -gt 0 ]; then
  echo "staging deploy permits only known runtime-generated untracked paths" >&2
  printf '%s\n' "${unsafe_untracked_files[@]}" >&2
  exit 2
fi

# Runtime contract gate (no Cloudflare auth needed).
npm run runtime-config:check

# Build and gate the exact Pages artifact before any remote migration or Worker mutation.
PL_BUILD_ENV=production PL_SERVER_URL="$staging_api_url" PL_PWA_URL="$staging_app_url" npm run pwa:build
node scripts/release/write-pwa-provenance.mjs --stage staging --sha "$PADLOC_DEPLOY_SHA"
npm run pwa:check

# All Cloudflare-authenticated steps run under the governed ch5-padloc-staging token.
# The token env vars propagate to every wrangler subprocess (migrate, worker, Pages).
export STAGING_PAGES_PROJECT="$staging_pages_project"
hush run --target wrangler-deploy-staging -- bash -euo pipefail -c '
  npm run worker:migrate:staging
  npm --prefix packages/worker exec -- wrangler deploy --config packages/worker/wrangler.toml --env=staging --var "VERSION:${PADLOC_DEPLOY_SHA}" --var "HQ_RELEASE:padloc-worker@${PADLOC_DEPLOY_SHA}"
  npm run pwa:check
  ./node_modules/.bin/wrangler pages deploy packages/pwa/dist --project-name "$STAGING_PAGES_PROJECT" --branch main
'
