{
    "name": "elf-vault",
    "packageManager": "npm@11.4.2",
    "private": true,
    "version": "4.3.0",
    "description": "A minimalist password manager",
    "author": "Martin Kleinschrodt <martin@maklesoft.com>",
    "license": "GPL-3.0",
    "homepage": "https://vault.elf.dance/",
    "engines": {
        "node": "24.x",
        "npm": "11.x"
    },
    "main": "main.js",
    "devDependencies": {
        "@types/node": "14.18.63",
        "concurrently": "7.6.0",
        "cypress": "12.5.1",
        "http-server": "14.1.0",
        "lerna": "5.1.8",
        "maildev": "git+https://github.com/padloc/maildev.git#master",
        "prettier": "2.8.4",
        "ts-node": "10.0.0",
        "turbo": "2.10.5",
        "typescript": "4.4.3",
        "wait-on": "7.0.1",
        "wrangler": "4.59.2"
    },
    "scripts": {
        "postinstall": "bash scripts/ci-bootstrap-workspaces.sh",
        "bootstrap": "bash scripts/ci-bootstrap-workspaces.sh",
        "ci-private-registry:check": "node scripts/check-ci-private-registry.mjs",
        "ci-private-registry:test": "node scripts/check-ci-private-registry.test.mjs",
        "worker:dev": "ch5-svc up api",
        "worker:dev:remote": "npm --prefix packages/worker run dev:remote",
        "worker:deploy:dry-run": "npm --prefix packages/worker run deploy:dry-run",
        "worker:deploy:preview": "npm --prefix packages/worker run deploy:preview",
        "worker:deploy:staging": "npm --prefix packages/worker run deploy:staging",
        "worker:deploy:production": "npm --prefix packages/worker run deploy:production",
        "worker:migrate:local": "npm --prefix packages/worker run migrate:local",
        "worker:migrate:preview": "npm --prefix packages/worker run migrate:preview",
        "worker:migrate:staging": "npm --prefix packages/worker run migrate:staging",
        "worker:migrate:production": "npm --prefix packages/worker run migrate:production",
        "pwa:build": "PL_SERVER_URL=${PL_SERVER_URL:?set PL_SERVER_URL} PL_PWA_URL=${PL_PWA_URL:?set PL_PWA_URL} lerna run build --scope @elf-vault/pwa",
        "pwa:check": "node scripts/check-pwa-dist.cjs",
        "test:pwa:dist": "node scripts/check-pwa-dist.test.cjs",
        "pwa:start": "ch5-svc up web",
        "electron:start": "lerna run start --scope @elf-vault/electron",
        "electron:build": "lerna run build --scope @elf-vault/electron",
        "electron:build:flatpak": "lerna run build:flatpak --scope @elf-vault/electron",
        "web-extension:preflight": "npm --prefix packages/extension run check:source && if [ -f packages/extension/dist/manifest.json ]; then npm --prefix packages/extension run preflight:dist; fi",
        "cache-proof": "node scripts/preflight-web-extension-source.cjs && mkdir -p .cache-proof && node -e \"const fs=require('fs'),c=require('crypto');const files=['package.json','packages/extension/package.json','packages/extension/manifest.json'].filter(fs.existsSync);const hash=c.createHash('sha256');for(const file of files)hash.update(fs.readFileSync(file));fs.writeFileSync('.cache-proof/padloc-extension.json',JSON.stringify({files,sha256:hash.digest('hex')}))\"",
        "web-extension:build": "turbo run web-extension:build:raw",
        "web-extension:build:raw": "node scripts/build-web-extension.cjs",
        "cordova:start:android": "lerna run start:android",
        "cordova:start:ios": "lerna run start:ios",
        "cordova:build": "lerna run build:android && lerna run build:ios",
        "cordova:build:android": "lerna run build:android --scope @elf-vault/cordova",
        "cordova:build:android:signed": "lerna run build:android:signed --scope @elf-vault/cordova",
        "cordova:build:ios": "lerna run build:ios --scope @elf-vault/cordova",
        "cordova:build:ios:signed": "lerna run build:ios:signed",
        "start": "ch5-svc up web",
        "server:start-dry": "npm run worker:deploy:dry-run",
        "start:v3": "ch5-svc up v3",
        "dev": "ch5-svc up web",
        "tauri:dev": "ch5-svc up tauri",
        "tauri:update": "lerna run update-tauri",
        "tauri:build": "lerna run build --scope @elf-vault/tauri",
        "tauri:build:debug": "lerna run build:debug --scope @elf-vault/tauri",
        "test": "lerna run test",
        "test:extension": "npm run web-extension:build && npm run --prefix packages/extension test:harness",
        "test:extension:headful": "PADLOC_EXTENSION_HEADFUL=1 npm run test:extension",
        "test:changed": "scripts/test-changed.sh --include-untracked",
        "test:extension:passkey-broker": "npm --prefix packages/extension run test:passkey-broker",
        "test:e2e": "ch5-svc up web v3 maildev && bash scripts/run-e2e.sh run",
        "test:e2e:dev": "ch5-svc up web v3 maildev && bash scripts/run-e2e.sh open",
        "test:services": "node scripts/test-pitchfork-config.mjs",
        "agent:test-identity": "node scripts/provision-agent-test-identity.mjs",
        "proof:old-origin-pwa": "node scripts/proof-old-origin-pwa.mjs",
        "locale:extract": "lerna run extract --scope '@elf-vault/locale'",
        "add": "lerna add $1 --exact --scope=@elf-vault/$scope",
        "remove": "rm packages/$scope/package-lock.json && lerna exec \"npm uninstall $1\" --scope=@elf-vault/$scope",
        "prettier": "prettier --write .",
        "prettier:check": "prettier --check .",
        "prettier:check:changed": "bash scripts/check-format-changed.sh",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "proof:contract": "bash scripts/proof-lanes/proof-contract.sh",
        "proof:crypto": "bash scripts/proof-lanes/proof-crypto.sh",
        "proof:worker": "bash scripts/proof-lanes/proof-worker.sh",
        "proof:client": "bash scripts/proof-lanes/proof-client.sh",
        "proof:migration": "bash scripts/proof-lanes/proof-migration.sh",
        "proof:extension": "bash scripts/proof-lanes/proof-extension.sh",
        "proof:passkeys:pr": "bash scripts/proof-lanes/proof-passkeys.sh --pr",
        "proof:passkeys:macos-contract": "bash scripts/proof-lanes/proof-passkeys.sh --macos-contract",
        "proof:passkeys": "bash scripts/proof-lanes/proof-passkeys.sh",
        "proof:passkeys:system": "bash scripts/proof-lanes/proof-passkeys.sh && PADLOC_NATIVE_SYSTEM_E2E=1 npm --prefix packages/extension run test:passkey-rp:native",
        "passkeys:native:test-injected": "bash scripts/proof-lanes/proof-native-injected.sh",
        "passkeys:native:install": "bash scripts/install-native-passkey-provider.sh",
        "proof:help": "bash scripts/proof-lanes/help.sh",
        "proof:all": "npm run proof:contract && npm run proof:crypto && npm run proof:worker && npm run proof:client && npm run proof:migration && npm run proof:extension",
        "runtime-config:check": "node scripts/check-runtime-config.mjs",
        "brand:check": "node scripts/check-customer-surface.mjs && node scripts/check-email-templates.mjs && node scripts/check-publishable-identifiers.mjs",
        "theme:check": "node scripts/check-ch5-theme.mjs",
        "release:manifest:build": "node scripts/release/build-manifest.mjs",
        "release:manifest:validate": "node scripts/release/validate-manifest.mjs",
        "release:notes": "node scripts/release/generate-notes.mjs",
        "release:canary": "node scripts/release/canary.mjs",
        "hush": "hush",
        "hush:status": "hush status",
        "hush:check": "hush check",
        "svc:ensure": "ch5-svc up api web v3 maildev",
        "svc:status": "ch5-svc status",
        "svc:attach": "ch5-svc logs api",
        "svc:stop": "ch5-svc down",
        "deploy:staging": "bash scripts/deploy-staging",
        "deploy:production": "bash scripts/deploy-production",
        "update-version": "lerna version $1 --yes",
        "version": "lerna version $1 --yes",
        "publish": "lerna publish",
        "publishable-identifiers:check": "node scripts/check-publishable-identifiers.mjs",
        "test:publishable-identifiers": "node --test scripts/check-publishable-identifiers.test.mjs"
    }
}
