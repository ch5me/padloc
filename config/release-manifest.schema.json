{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pad.ch5.me/schemas/release-manifest-v1.json",
    "title": "CH5 Auth public release manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "product",
        "version",
        "channel",
        "sourceSha",
        "publishedAt",
        "build",
        "releaseNotesUrl",
        "provenance",
        "artifacts"
    ],
    "properties": {
        "schemaVersion": { "const": 1 },
        "product": { "const": "ch5-auth" },
        "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "channel": { "enum": ["staging", "stable"] },
        "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "build": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "toolchain", "dependenciesLocked"],
            "properties": {
                "number": { "type": "string", "minLength": 1 },
                "toolchain": { "type": "string", "minLength": 1 },
                "dependenciesLocked": { "type": "boolean" }
            }
        },
        "releaseNotesUrl": { "type": "string", "format": "uri" },
        "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "commitUrl", "workflow", "runUrl", "promotionMode"],
            "properties": {
                "repository": { "type": "string", "format": "uri" },
                "commitUrl": { "type": "string", "format": "uri" },
                "workflow": { "type": "string", "minLength": 1 },
                "runUrl": { "type": "string", "format": "uri" },
                "promotionMode": { "enum": ["original-artifact", "exact-source-rebuild"] }
            }
        },
        "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "platform",
                    "architecture",
                    "file",
                    "url",
                    "sha256",
                    "size",
                    "signature",
                    "notarization",
                    "minimumOs",
                    "compatibility"
                ],
                "properties": {
                    "platform": { "enum": ["web-extension", "android", "ios", "linux", "macos", "windows"] },
                    "architecture": { "type": "string", "minLength": 1 },
                    "file": { "type": "string", "pattern": "^[^/]+$" },
                    "url": { "type": "string", "format": "uri" },
                    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "size": { "type": "integer", "minimum": 1 },
                    "signature": { "enum": ["unsigned", "signed", "store-signed", "unknown"] },
                    "notarization": { "enum": ["not-applicable", "not-notarized", "notarized", "unknown"] },
                    "minimumOs": { "type": ["string", "null"] },
                    "compatibility": { "type": "string", "minLength": 1 }
                }
            }
        }
    }
}
